# ============================================================================
# Шаблон сборки ROS2-пакета с CUDA (multi-stage: builder → final)
# ============================================================================
# Универсальный. Никаких if по имени пакета.
# Пакет-специфичные зависимости подключаются через PACKAGE_DEPS_SCRIPT.
#
# Аргументы:
#   BASE_IMAGE            — базовый образ (обязательно)
#   PACKAGE_GIT           — Git URL пакета (обязательно)
#   PACKAGE_BRANCH        — ветка (default: main)
#   PACKAGE_NAME          — имя пакета = имя директории в /ros2_ws/src
#   CMAKE_ARGS            — доп. флаги CMake
#   CUDA_ARCHITECTURES    — целевые CUDA-архитектуры (пусто = не передавать)
#   PACKAGE_DEPS_SCRIPT   — путь к скрипту установки специфичных зависимостей
#                            (относительно контекста сборки, например
#                             docker/package/deps/fast-livo2.sh)
# ============================================================================

ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS builder

ARG PACKAGE_GIT
ARG PACKAGE_BRANCH=main
ARG PACKAGE_NAME
ARG CMAKE_ARGS=""
ARG CUDA_ARCHITECTURES=""
ARG PACKAGE_DEPS_SCRIPT=""

SHELL ["/bin/bash", "-c"]

# --- Копируем hook-скрипты (небольшие, всегда) ---
COPY docker/package/deps/ /tmp/deps/

# --- Создаём рабочую директорию (перенесено из base) ---
USER root
RUN mkdir -p ${ROS2_WS}/src && chown -R ${ROS2_USER}:${ROS2_USER} ${ROS2_WS}
USER ${ROS2_USER}

WORKDIR ${ROS2_WS}/src

# --- Клонирование пакета ---
RUN git clone --depth 1 --branch ${PACKAGE_BRANCH} \
        ${PACKAGE_GIT} ${PACKAGE_NAME} && \
    rm -rf ${PACKAGE_NAME}/.git

# --- Пакет-специфичные зависимости (если задан скрипт) ---
# Универсальный шаблон: любая специфика — во внешнем hook-скрипте.
RUN if [ -n "${PACKAGE_DEPS_SCRIPT}" ]; then \
        echo "=== Running deps script: ${PACKAGE_DEPS_SCRIPT} ===" && \
        bash /tmp/deps/$(basename ${PACKAGE_DEPS_SCRIPT}) && \
        echo "=== Deps script complete ==="; \
    else \
        echo "=== No deps script — universal build ==="; \
    fi

# --- Сборка через colcon ---
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && \
    colcon build \
        --packages-select ${PACKAGE_NAME} \
        --cmake-args -DCMAKE_BUILD_TYPE=Release ${CMAKE_ARGS} \
            ${CUDA_ARCHITECTURES:+ -DCUDA_ARCHITECTURES=${CUDA_ARCHITECTURES}} \
        --parallel-workers $(nproc)

# ============================================================================
# Финальная стадия: только артефакты
# ============================================================================
FROM ${BASE_IMAGE} AS final

ARG PACKAGE_NAME
ENV PACKAGE_NAME=${PACKAGE_NAME}

# --- Копирование собранных артефактов с использованием контракта ---
COPY --from=builder --chown=${ROS2_USER}:${ROS2_USER} \
     ${ROS2_INSTALL} ${ROS2_INSTALL}

# --- Настройка окружения ---
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /home/${ROS2_USER}/.bashrc && \
    echo "source ${ROS2_INSTALL}/setup.bash" >> /home/${ROS2_USER}/.bashrc

WORKDIR ${ROS2_WS}
USER ${ROS2_USER}

LABEL org.opencontainers.image.title="${PACKAGE_NAME}" \
      org.opencontainers.image.description="ROS2 ${ROS_DISTRO} package: ${PACKAGE_NAME}"

CMD ["/bin/bash"]